{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "fix": "eslint --fix . && prettier --write .",
    "prepare": "husky",
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\" && node scripts/prepare-ocr.mjs",
    "test": "node --experimental-strip-types --test src/lib/mathCheck.test.ts src/lib/units.test.ts src/lib/boardStep.test.ts",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.50",
    "@ai-sdk/react": "^4.0.119",
    "@google/genai": "^2.24.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/katex": "^0.16.8",
    "ai": "^7.0.116",
    "fabric": "^7.4.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "mathjs": "^15.2.0",
    "modern-screenshot": "^4.7.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.2",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "typewriter-effect": "^2.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.15.0"
}
