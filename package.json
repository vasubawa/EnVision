{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "fix": "eslint --fix . && prettier --write .",
    "prepare": "husky",
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\" && node scripts/prepare-ocr.mjs",
    "test": "node --experimental-strip-types --test src/lib/mathCheck.test.ts src/lib/units.test.ts src/lib/boardStep.test.ts",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.71",
    "@ai-sdk/react": "^4.0.158",
    "@google/genai": "^2.31.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/katex": "^0.16.8",
    "ai": "^7.0.154",
    "fabric": "^7.4.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.62.0",
    "mathjs": "^15.2.0",
    "modern-screenshot": "^4.7.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "^20.1.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tesseract.js": "^7.0.0",
    "typewriter-effect": "^3.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.15.0"
}
